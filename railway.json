{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "sh -c 'cd api-server && ./start.sh'",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "serviceName": "api",
    "env": {
      "ENV": "development",
      "STRICT_MODE": "NO",
      "PYTHONPATH": "."
    }
  }
}
